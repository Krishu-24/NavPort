# Shell launchers must stay LF — a CRLF shebang makes macOS/Linux fail with
# "bad interpreter: /usr/bin/env bash^M".
*.command  text eol=lf
*.sh       text eol=lf

# Batch files are the opposite: cmd.exe wants CRLF.
*.bat      text eol=crlf

# Don't let line-ending conversion touch binaries.
*.png      binary
*.ico      binary
*.jpg      binary
*.gz       binary

# Third-party files are stored byte-for-byte. scripts/vendor_assets.py checks
# each against a pinned SHA-384, and upstream leaflet.css has CRLF line
# endings: converting them on commit changed 661 bytes, so the copy CI checked
# out never matched its own hash. No line-ending conversion, in either
# direction, for anything we didn't write.
frontend/public/vendor/** -text

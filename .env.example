# Copy to `.env` only if you want to override compose/Azure defaults.
# Compose already sets the local values. Azure sets the cloud values in
# `az containerapp create --env-vars`. Do not commit a filled-in `.env`.

# production | development
NAVPORT_ENV=production

# Azure and most hosts inject this. The Dockerfile defaults it to 8000.
# Local `python run.py` uses 5000 unless you set NAVPORT_PORT.
# PORT=8000

# true only behind a proxy that overwrites X-Forwarded-For (Azure ingress).
# false for docker compose on your laptop.
NAVPORT_TRUST_PROXY=false

# WEB_CONCURRENCY=2
# NAVPORT_THREADS=8
# NAVPORT_RATE_LIMIT=60
# NAVPORT_BRIEFING_RATE_LIMIT=10

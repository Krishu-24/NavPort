# Everything not needed to run the app. This matters for more than image size:
# the build context is uploaded to the daemon, and anything copied in becomes
# readable to anyone who pulls the image.

# Secrets — the important entries in this file
.env
.env.*
*.pem
*.key
*.pfx
*.p12
secrets/
.azure/

# Version control and CI
.git
.gitignore
.gitattributes
.github/

# Python
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local logs and scratch output
*.log
*.err
logs/

# Native app shells — these consume the container's API, they aren't part of it
desktop/
android/
ios/
node_modules/
dist/
build/
target/

# Development-only assets
ui_ideas/
docs/
tests/
scripts/
*.md
!README.md

# Editor and OS noise
.vscode/
.idea/
.cursor/
.DS_Store
Thumbs.db
desktop.ini

# Local launchers have no meaning in a container
run.bat
run.command
docker-compose*.yml
Dockerfile*
.dockerignore
